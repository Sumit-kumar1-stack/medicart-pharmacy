NODE_ENV=development
DATABASE_URL="postgresql://medicart:medicart@localhost:5432/medicart?schema=public"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="medicart_session"
SESSION_TTL_DAYS=14
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
# S3/R2 production storage
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# If true in production, local storage is blocked.
REQUIRE_REMOTE_STORAGE_IN_PRODUCTION=true
# Demo payment provider. Replace with Razorpay/Stripe adapter before real money.
PAYMENT_PROVIDER="demo"
ALLOW_DEMO_PAYMENTS_IN_PRODUCTION=false
